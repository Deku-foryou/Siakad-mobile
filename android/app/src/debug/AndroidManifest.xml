<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- DEVELOPMENT ONLY: mengizinkan HTTP cleartext agar emulator/perangkat
         uji bisa mengakses backend lokal (http://10.0.2.2 / http://LAN-IP).
         Build release TIDAK mewarisi atribut ini (lihat main manifest:
         usesCleartextTraffic="false" — production wajib HTTPS). -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
